# Konfigurasi Supabase — Bank Sampah Syariah UINSA
# Salin file ini menjadi .env.local lalu isi dengan kredensial Project Supabase Anda
# (Dashboard Supabase -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# KHUSUS SERVER-SIDE (API Routes) — JANGAN pernah diekspos ke client / browser!
# Dibutuhkan Admin untuk membuat/menghapus akun Petugas & Bendahara melalui Supabase Auth Admin API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
